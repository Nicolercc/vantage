# Copy to .env and fill in. Required variables are uncommented; uncomment an
# optional one to set it. Defaults are given in the descriptions.

# --- API server (@workspace/api-server) ---

# Required locally: the port the API listens on. Use 3001, where the client's
# development proxy expects it. Hosting platforms such as Render supply it.
PORT=
# Required: Anthropic API key. (The older name AI_INTEGRATIONS_ANTHROPIC_API_KEY
# is still read.)
ANTHROPIC_API_KEY=
# Optional: a different Anthropic API base URL (AI_INTEGRATIONS_ANTHROPIC_BASE_URL
# is still read).
# ANTHROPIC_BASE_URL=
# Optional: "production" for JSON logs and production checks. pnpm dev:api sets
# "development".
# NODE_ENV=
# Optional: pino log level. Default info.
# LOG_LEVEL=

# Browser origins allowed to call the API, comma-separated. Default: the
# deployed site and http://localhost:5173.
# CORS_ORIGINS=
# Requests per client per window (default 20) and the window in minutes (default 10).
# RATE_LIMIT_MAX=
# RATE_LIMIT_WINDOW_MINUTES=
# New briefs generating at once per process (default 4) and per UTC day (default 300).
# BRIEF_MAX_CONCURRENT=
# BRIEF_DAILY_BUDGET=
# How long a brief is reused for the same request, in minutes (default 360),
# and how many are cached (default 200).
# BRIEF_CACHE_TTL_MINUTES=
# BRIEF_CACHE_MAX_ENTRIES=
# Writer model id (default claude-haiku-4-5-20251001) and its per-call deadline
# in milliseconds (default 60000).
# BRIEF_MODEL=
# BRIEF_MODEL_TIMEOUT_MS=
# The second model that checks each claim against its quotes: "on" (default) or
# "off". With "off", claims are served as unverified.
# BRIEF_VERIFY=
# Verifier model id (default claude-haiku-4-5-20251001) and its per-call
# deadline in milliseconds (default 25000).
# BRIEF_VERIFIER_MODEL=
# BRIEF_VERIFIER_TIMEOUT_MS=
# Geocoder search endpoint (default OpenStreetMap Nominatim), the User-Agent
# sent to it, the gap between lookups in milliseconds (default 1100, as
# Nominatim's policy asks), and how long a brief waits for its places in
# milliseconds (default 9000).
# GEOCODER_URL=
# GEOCODER_USER_AGENT=
# GEOCODER_MIN_GAP_MS=
# GEOCODER_BUDGET_MS=

# A postgres:// connection string. When set, saved briefs, rate limits, the
# daily budget and the cost ledger are kept there, shared by instances and
# kept across restarts; tables are created on first use. When unset,
# everything is kept in memory until the next restart.
# DATABASE_URL=
# "true" to refuse to start without DATABASE_URL. Default false.
# REQUIRE_DATABASE=

# A random string of at least 24 characters. GET /api/ops/costs answers only to
# "Authorization: Bearer <this>", and does not exist when it is unset.
# OPS_TOKEN=
# Prices for models besides the default, as JSON in US dollars per million
# tokens: {"<model-id>":{"input":<n>,"output":<n>}}
# MODEL_PRICES=

# --- Vantage client (Vite) ---

# Build time: the API's origin, without a trailing slash, when the client is
# hosted on a different origin than the API. Leave unset for same-origin /api,
# including local development.
# VITE_API_BASE_URL=
# Local development only, read from the shell rather than this file: where
# `pnpm dev` proxies /api. Default http://localhost:3001.
# Example: VITE_API_PROXY_TARGET=<api origin> pnpm dev
# VITE_API_PROXY_TARGET=
